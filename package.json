{
  "name": "sanskrit-strands",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "validate:puzzles": "node scripts/validate-puzzles.mjs",
